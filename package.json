{
  "name": "acu-primer",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fake": "FAKE_DRAFTS=1 vite",
    "dev:fake-failures": "FAKE_DRAFTS=some-fail vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "check": "tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.json",
    "types": "wrangler types src/worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply acu-primer --local -c wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply acu-primer --remote -c wrangler.jsonc",
    "import:local": "tsx scripts/import-lesson.ts --local",
    "import:remote": "tsx scripts/import-lesson.ts --remote",
    "export:subject": "tsx scripts/export-subject.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.13.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lucide/svelte": "^1.61.0",
    "katex": "^0.18.9",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260923.1": true
  }
}
